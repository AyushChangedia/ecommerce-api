DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# At least 32 characters, and not this placeholder — the server refuses to
# start otherwise. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
PORT=3000

# The database certificate is verified by default. If your provider signs with
# its own authority, give it here — either the PEM itself or a path to one.
# DATABASE_CA_CERT=/etc/ssl/certs/rds-ca.pem
#
# Last resort for a throwaway environment. The connection stays encrypted but
# the database is no longer asked to prove who it is, so anything on the
# network path can impersonate it. The server warns at startup.
# DATABASE_SSL_INSECURE=false

# How many proxies sit in front of the API. req.ip must resolve to the caller,
# not the load balancer, or the login rate limiter counts every client as one.
TRUST_PROXY_HOPS=1

# How long to let in-flight requests finish after SIGTERM. Keep it under the
# platform's own patience (10s on Heroku, 30s on Kubernetes by default).
SHUTDOWN_GRACE_MS=8000
